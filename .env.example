# ===== 课程生成器 / 沙箱注入 (OpenAI 兼容接口, 默认 DeepSeek) =====
# DeepSeek 申请 key: https://platform.deepseek.com/api_keys
# 接口完全兼容 OpenAI SDK, 改 base_url 即可切换厂商:
#   DeepSeek: https://api.deepseek.com            model=deepseek-v4-pro
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-max
#   Moonshot: https://api.moonshot.cn/v1           model=moonshot-v1-8k
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.deepseek.com
GENERATOR_MODEL=deepseek-v4-pro

# ===== 后端 (M2) =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4200
CORS_ORIGINS=http://localhost:3200
SANDBOX_IMAGE=llmquest-sandbox:latest
SANDBOX_MAX_CONCURRENCY=5
SANDBOX_DEFAULT_TIMEOUT=10
DATA_DIR=app/data

# ===== 公网防护(服务器版, 本地开发留空即可) =====
# 访问口令(邀请码), 逗号分隔多个; 空 = 关闭门槛, 本地开发无感
ACCESS_CODES=
# 每 IP 每分钟沙箱运行次数上限; 0 = 不限
SANDBOX_RATE_LIMIT=10

# ===== 前端 (Vite 前缀, M3+) =====
VITE_API_BASE_URL=http://localhost:4200
VITE_USE_LOCAL_CURRICULUM=true
